{
  "name": "conductor",
  "version": "0.0.0",
  "private": true,
  "description": "Conductor monorepo: messaging orchestration hub and adapter libraries",
  "license": "MPL-2.0",
  "author": "Losen",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/conductor.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:tag": "changeset git-tag",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0"
  }
}
